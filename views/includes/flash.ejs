<%
  const flashes = [
    { msg: typeof success !== "undefined" && success, kind: "success", icon: "fa-circle-check" },
    { msg: typeof update !== "undefined" && update, kind: "update", icon: "fa-pen" },
    { msg: typeof deleteMsg !== "undefined" && deleteMsg, kind: "delete", icon: "fa-trash" },
    { msg: typeof review !== "undefined" && review, kind: "review", icon: "fa-star" },
    { msg: typeof error !== "undefined" && error, kind: "error", icon: "fa-circle-exclamation" },
  ].filter((f) => f.msg && f.msg.length);
%>
<% if (flashes.length) { %>
  <div class="flashMessages">
    <% flashes.forEach((f) => { %>
      <div class="flashMessage flashMessage--<%= f.kind %> flashAutoDismiss" role="alert" aria-live="polite">
        <i class="fa-solid <%= f.icon %> flashIcon"></i>
        <span><%= f.msg %></span>
        <button type="button" class="flashClose" aria-label="Dismiss alert" onclick="this.closest('.flashMessage').remove()">&times;</button>
      </div>
    <% }) %>
  </div>
<% } %>
