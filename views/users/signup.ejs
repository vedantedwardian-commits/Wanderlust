<% layout("/layouts/boilerplate.ejs") %>

<main class="auth-page">
  <form method="POST" action="/signup" class="auth-card">
    <header class="auth-header">Sign up</header>
    <div class="auth-body">
      <h1>Welcome to WanderLust</h1>

      <div class="field-group">
        <label class="field">
          <span>Username</span>
          <input name="username" autocomplete="username" required />
        </label>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label class="field">
          <span>Password</span>
          <input name="password" type="password" autocomplete="new-password" required />
        </label>
      </div>

      <p class="auth-fine">
        By selecting <strong>Agree and continue</strong>, I agree to WanderLust's
        <a href="/terms">Terms of Service</a> and acknowledge the
        <a href="/privacy">Privacy Policy</a>.
      </p>

      <button class="btn-brand auth-submit">Agree and continue</button>

      <div class="auth-divider"><span>or</span></div>

      <p class="auth-switch">
        Already have an account? <a href="/signin">Log in</a>
      </p>
    </div>
  </form>
</main>
