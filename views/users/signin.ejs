<% layout("/layouts/boilerplate.ejs") %>

<main class="auth-page">
  <form method="POST" action="/signin" class="auth-card">
    <header class="auth-header">Log in</header>
    <div class="auth-body">
      <h1>Welcome back to WanderLust</h1>

      <div class="field-group">
        <label class="field">
          <span>Username</span>
          <input name="username" autocomplete="username" required />
        </label>
        <label class="field">
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
      </div>

      <button class="btn-brand auth-submit">Continue</button>

      <div class="auth-divider"><span>or</span></div>

      <p class="auth-switch">
        New to WanderLust? <a href="/signup">Create an account</a>
      </p>
    </div>
  </form>
</main>
