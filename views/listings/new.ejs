<% layout("/layouts/boilerplate.ejs") %>

<main class="host-page">
  <form method="POST" action="/listings" enctype="multipart/form-data" class="host-form">
    <header class="host-header">
      <p class="host-kicker">Become a host</p>
      <h1>Tell us about your place</h1>
    </header>

    <%- include("../includes/listingFields.ejs", { listing: null }) %>

    <footer class="host-actions">
      <a href="/listings" class="btn-plain">Back</a>
      <button class="btn-brand">Publish listing</button>
    </footer>
  </form>
</main>

<script src="/js/forms.js"></script>
