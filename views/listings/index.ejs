<% layout("/layouts/boilerplate.ejs") %>

<main class="results">
  <header class="results-header">
    <div>
      <p class="results-count">
        <%= listings.length %> stay<%= listings.length !== 1 ? "s" : "" %>
      </p>
      <h1 class="results-title">
        <%= q ? `Stays matching "${q}"` : "Explore all stays" %>
      </h1>
    </div>
    <% if (q) { %>
      <a href="/listings" class="results-clear">Clear search</a>
    <% } %>
  </header>

  <% if (!listings.length) { %>
    <div class="results-empty">
      <i class="fa-solid fa-magnifying-glass"></i>
      <h2>No exact matches</h2>
      <p>Try changing or removing your search to see more stays.</p>
      <a href="/listings" class="btn-outline">Show all stays</a>
    </div>
  <% } else { %>
    <section class="results-grid">
      <% for (const list of listings) { %>
        <%- include("../includes/stayCard.ejs", { list }) %>
      <% } %>
    </section>
  <% } %>
</main>
