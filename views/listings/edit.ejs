<% layout("/layouts/boilerplate.ejs") %>

<main class="host-page">
  <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="host-form">
    <header class="host-header">
      <p class="host-kicker">Listing editor</p>
      <h1>Edit your listing</h1>
    </header>

    <%- include("../includes/listingFields.ejs", { listing }) %>

    <footer class="host-actions">
      <a href="/listings/<%= listing._id %>" class="btn-plain">Cancel</a>
      <button class="btn-brand">Save changes</button>
    </footer>
  </form>
</main>

<script src="/js/forms.js"></script>
