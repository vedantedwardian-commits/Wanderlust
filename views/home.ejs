<% layout("/layouts/boilerplate.ejs") %>
<%
  const categories = [
    { label: "All", icon: "fa-house", keywords: [] },
    { label: "Beachfront", icon: "fa-umbrella-beach", keywords: ["beach", "ocean", "sea", "coast", "island"] },
    { label: "Cabins", icon: "fa-tree", keywords: ["cabin", "cottage", "chalet", "lodge"] },
    { label: "Mountains", icon: "fa-mountain", keywords: ["mountain", "hill", "alps", "peak"] },
    { label: "Iconic cities", icon: "fa-city", keywords: ["city", "downtown", "loft", "urban", "apartment"] },
    { label: "Castles", icon: "fa-chess-rook", keywords: ["castle", "historic", "palace"] },
    { label: "Lakefront", icon: "fa-water", keywords: ["lake", "river"] },
    { label: "Countryside", icon: "fa-wheat-awn", keywords: ["country", "farm", "village", "vineyard", "tuscany"] },
    { label: "Tropical", icon: "fa-sun", keywords: ["tropical", "bali", "maldives", "jungle", "paradise"] },
    { label: "Villas", icon: "fa-gem", keywords: ["villa", "luxury", "mansion"] },
    { label: "Skiing", icon: "fa-person-skiing", keywords: ["ski", "snow", "winter"] },
    { label: "Camping", icon: "fa-campground", keywords: ["camp", "tent", "safari", "treehouse"] },
    { label: "Arctic", icon: "fa-snowflake", keywords: ["arctic", "igloo", "iceland", "aurora"] },
  ];
%>

<div class="home">
  <!-- ── SEARCH BAR ─────────────────────────────────── -->
  <section class="home-search">
    <form action="/listings" method="GET" class="search-pill" role="search">
      <label class="search-field search-field--where">
        <span class="search-label">Where</span>
        <input type="text" name="q" placeholder="Search destinations" autocomplete="off" />
      </label>
      <span class="search-divider"></span>
      <label class="search-field">
        <span class="search-label">Check in</span>
        <input type="date" name="checkin" />
      </label>
      <span class="search-divider"></span>
      <label class="search-field">
        <span class="search-label">Check out</span>
        <input type="date" name="checkout" />
      </label>
      <span class="search-divider"></span>
      <label class="search-field search-field--who">
        <span class="search-label">Who</span>
        <input type="number" name="guests" min="1" max="16" placeholder="Add guests" />
      </label>
      <button type="submit" class="search-btn" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i><span>Search</span>
      </button>
    </form>
  </section>

  <!-- ── CATEGORY STRIP ─────────────────────────────── -->
  <nav class="category-bar" aria-label="Categories">
    <div class="category-track">
      <% categories.forEach((cat, i) => { %>
        <button type="button"
                class="category<%= i === 0 ? ' is-active' : '' %>"
                data-keywords="<%= cat.keywords.join(',') %>">
          <i class="fa-solid <%= cat.icon %>"></i>
          <span><%= cat.label %></span>
        </button>
      <% }) %>
    </div>
  </nav>

  <!-- ── LISTING ROWS ───────────────────────────────── -->
  <main class="home-rows">
    <% if (!listings.length) { %>
      <div class="home-empty">
        <i class="fa-regular fa-compass"></i>
        <h2>No stays yet</h2>
        <p>Be the first to share a place with travellers.</p>
        <a href="/listings/new" class="home-btn">Add a location</a>
      </div>
    <% } %>

    <% sections.forEach((section) => { %>
      <section class="listing-row">
        <div class="row-header">
          <a href="/listings?q=<%= encodeURIComponent(section.country) %>" class="row-title">
            Popular homes in <%= section.country %> <i class="fa-solid fa-chevron-right"></i>
          </a>
          <div class="row-arrows">
            <button type="button" class="row-arrow" data-dir="-1" aria-label="Scroll left">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="row-arrow" data-dir="1" aria-label="Scroll right">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </div>

        <div class="row-track">
          <% section.items.forEach((list) => { %>
            <%- include("includes/stayCard.ejs", { list }) %>
          <% }) %>
        </div>
      </section>
    <% }) %>

    <div class="home-empty home-empty--filter" hidden>
      <i class="fa-solid fa-magnifying-glass"></i>
      <h2>No exact matches</h2>
      <p>Try a different category, or browse all stays.</p>
      <button type="button" class="home-btn home-btn--outline" data-reset>Show all</button>
    </div>
  </main>

  <!-- ── INSPIRATION ────────────────────────────────── -->
  <% if (destinations.length) { %>
    <section class="inspiration">
      <h2 class="inspiration-title">Inspiration for future getaways</h2>
      <div class="inspiration-tabs" role="tablist">
        <% destinations.forEach((d, i) => { %>
          <button type="button" role="tab"
                  class="inspiration-tab<%= i === 0 ? ' is-active' : '' %>"
                  data-tab="<%= i %>"><%= d.country %></button>
        <% }) %>
      </div>
      <% destinations.forEach((d, i) => { %>
        <ul class="inspiration-grid" data-panel="<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
          <% d.places.forEach((p) => { %>
            <li>
              <a href="/listings?q=<%= encodeURIComponent(p.location) %>">
                <strong><%= p.location %></strong>
                <span><%= p.count %> stay<%= p.count !== 1 ? "s" : "" %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% }) %>
    </section>
  <% } %>

  <!-- ── HOST BANNER ────────────────────────────────── -->
  <section class="host-banner">
    <div class="host-banner-inner">
      <div>
        <h2>Become a host</h2>
        <p>Share your space, earn extra income and open your door to travellers from around the world.</p>
      </div>
      <a href="/listings/new" class="home-btn">WanderLust your home</a>
    </div>
  </section>
</div>

<script src="/js/home.js"></script>
